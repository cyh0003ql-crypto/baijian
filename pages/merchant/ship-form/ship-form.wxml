<scroll-view scroll-y="page">
  <view class="page-title">{{isShipped ? '补充物流信息' : '填写物流信息'}}</view>
  <view class="page-sub">订单号：{{orderId}}</view>
  <view class="form-section">
    <text class="section-label">快递公司（选填）</text>
    <view class="form-group"><input class="f-input" placeholder="如：顺丰、京东快递、中通" bindinput="onCarrierInput" confirm-type="next" /></view>
  </view>
  <view class="form-section">
    <text class="section-label">物流单号（选填）</text>
    <view class="form-group"><input class="f-input" placeholder="可暂不填写，稍后补充" bindinput="onNumberInput" confirm-type="done" /></view>
  </view>
  <view class="tips-block"><text class="tip-text">📦 可以先一键发货，物流单号后续在订单中补充</text></view>
  <button wx:if="{{!isShipped}}" class="quick-ship-btn" bindtap="onQuickShip">一键发货，稍后补单号</button>
  <button class="save-btn" bindtap="onSave">{{isShipped ? '保存物流信息' : '填写物流并发货'}}</button>
  <view style="height:60rpx;"></view>
</scroll-view>
